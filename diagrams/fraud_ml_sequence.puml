@startuml Fraud_ML_Sequence
title TokerBank AI Fraud Shield - Inference Flow

skinparam maxMessageSize 150
skinparam backgroundColor #FFFFFF
skinparam sequence {
    ArrowColor #2C3E50
    LifeLineBorderColor #34495E
    LifeLineBackgroundColor #ECF0F1
    ParticipantBorderColor #2980B9
    ParticipantBackgroundColor #3498DB
    ParticipantFontColor #FFFFFF
    ParticipantFontSize 14
    ParticipantFontName Arial
}

actor "User" as User
participant "BankingController\n(via API Gateway)" as Controller
participant "BankingService" as Service
participant "MlFraudInferenceEngine" as MLEngine
participant "FeatureEngineeringService" as FeatureEng
participant "ONNX Runtime\n(XGBoost Model)" as ONNX
database "PostgreSQL\n(Fraud Tables)" as DB
participant "Kafka\n(fraud-alerts)" as Kafka

User -> Controller: POST /transfers (Amount, IBAN, Device ID, IP)
activate Controller

Controller -> Service: processTransfer(request)
activate Service

Service -> MLEngine: evaluate(user, tx_details)
activate MLEngine

MLEngine -> FeatureEng: computeFeatures(...)
activate FeatureEng
FeatureEng --> MLEngine: Map<String, Object> (18-Feature Vector)
deactivate FeatureEng

MLEngine -> MLEngine: Convert to double[] & Create Input Tensor

alt If ONNX Model is Loaded
    MLEngine -> ONNX: session.run(tensor)
    activate ONNX
    ONNX --> MLEngine: fraudProb (e.g., 0.85)
    deactivate ONNX
    MLEngine -> MLEngine: ML Score (fraudProb * 100) = 85.0
else If No Model / Error (Fallback)
    MLEngine -> MLEngine: ML Score = 0 (Skipped)
end

MLEngine -> MLEngine: computeRuleBasedScore(features) -> Rule Score (e.g., 45)
MLEngine -> MLEngine: Hybrid Score = (ML * 0.7) + (Rule * 0.3) = 73.0

MLEngine -> MLEngine: determineRiskLevel() -> "HIGH"
MLEngine -> MLEngine: determineDecision() -> "PUSH_CHALLENGED"
MLEngine -> MLEngine: computeShapExplanations() -> SHAP JSON (Reasons)

MLEngine -> DB: save(FraudFeatureStore) (Snapshot of 18 Features)
MLEngine -> DB: save(FraudEvaluation) (Risk Score, Decision, SHAP, Latency)

MLEngine --> Service: FraudEvaluation Result
deactivate MLEngine

alt Decision == "COMPLETED" (0-30 Points)
    Service -> DB: save(Transaction - APPROVED)
    Service -> Kafka: event(TRANSFER_COMPLETED)
    Service --> Controller: Success Response (200 OK)
    Controller --> User: Transfer Executed
else Decision == "PUSH_CHALLENGED" (31-84 Points)
    Service -> DB: save(Transaction - PENDING_OTP/PUSH)
    Service -> Kafka: event(TRANSFER_PENDING)
    Service --> Controller: Pending (202 Accepted - Push Required)
    Controller --> User: Redirect to Mobile Approval Screen!
else Decision == "CRITICAL_PUSH_CHALLENGED" (85-100 Points)
    Service -> DB: save(Transaction - PENDING_CRITICAL)
    Service -> Kafka: event(FRAUD_ALERT_CRITICAL)
    Service --> Controller: Pending (202 Accepted - OTP + Push Required)
    Controller --> User: Request OTP and Push Verification!
end

deactivate Service
deactivate Controller
@enduml
