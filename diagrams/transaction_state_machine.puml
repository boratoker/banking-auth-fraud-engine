@startuml Transaction_Risk_Tree
title TokerBank - Transfer & Adaptive Risk State Tree Diagram

' ============================================================
'  Hierarchical Tree-Structured State and Decision Architecture
' ============================================================

top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 10
skinparam nodesep 25
skinparam ranksep 40

' --- Style Definitions ---
skinparam state {
  BorderColor #475569
  BorderThickness 1.2
  FontColor #0F172A
  FontSize 11
  FontStyle bold
  ArrowColor #334155
  ArrowFontColor #1E293B
  ArrowFontSize 10
}

' ============================================================
'  1. ROOT NODE
' ============================================================

[*] --> S_EVAL : Transfer Request (POST /transfers)\n[Balance & Daily Limit Valid]

state "PENDING_EVALUATION\n---\n• 18-Feature Vector Extraction\n• ONNX XGBoost Risk Score (0-100)\n• Rule: Amount > 500k & Balance > 70%" as S_EVAL #FEF3C7

' ============================================================
'  2. TREE BRANCHES
' ============================================================

' --- BRANCH 1: Low Risk ---
state "BRANCH 1: LOW RISK (0% - 25%)" as Branch1 #F0FDF4 {
  state "APPROVE\n(Direct Approval)" as B1_Approve #DCFCE7
  state "COMPLETED\n(Balance Transferred)" as B1_Comp #86EFAC
  
  B1_Approve --> B1_Comp : Deduct Balance
}

' --- BRANCH 2: Medium & High Risk ---
state "BRANCH 2: MEDIUM / HIGH RISK (26% - 80%)" as Branch2 #EFF6FF {
  state "PUSH_CHALLENGED\n(Awaiting Mobile Approval)" as B2_Push #DBEAFE
  state "COMPLETED\n(Transfer Successful)" as B2_Comp #86EFAC
  state "REJECTED\n(Transaction Cancelled)" as B2_Rej #FECDD3
  
  B2_Push --> B2_Comp : 'APPROVE' on Mobile
  B2_Push --> B2_Rej : 'REJECT' / 60s Timeout
}

' --- BRANCH 3: Critical Risk ---
state "BRANCH 3: CRITICAL RISK (81% - 100% or Rule)" as Branch3 #FFF7ED {
  state "CRITICAL_PUSH_CHALLENGED\n(Stage 1: Mobile Push)" as B3_Crit #FED7AA
  state "OTP_CHALLENGED\n(Stage 2: Email OTP)" as B3_Otp #FDBA74
  state "COMPLETED\n(Transfer Successful)" as B3_Comp #86EFAC
  state "REJECTED\n(Transaction Cancelled)" as B3_Rej #FECDD3
  
  B3_Crit --> B3_Otp : Stage 1 Approved
  B3_Crit --> B3_Rej : Stage 1 Rejected
  B3_Otp --> B3_Comp : Stage 2 Correct OTP
  B3_Otp --> B3_Rej : Invalid Code / Timeout
}


' ============================================================
'  ROOT TO BRANCH DISTRIBUTION
' ============================================================

S_EVAL --> B1_Approve : [Risk Score 0 - 25]
S_EVAL --> B2_Push : [Risk Score 26 - 80]
S_EVAL --> B3_Crit : [Risk Score 81 - 100\nor Critical Rule]

@enduml
