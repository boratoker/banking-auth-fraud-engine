@startuml Transaction_Risk_Tree
title TokerBank - Transfer & Adaptif Risk Karar Ağacı (State Tree Diagram)

' ============================================================
'  Hiyerarşik Ağaç (Tree-Structured) Durum ve Karar Mimarisi
' ============================================================

top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundcorner 10
skinparam nodesep 25
skinparam ranksep 40

' --- Stil Tanımları ---
skinparam state {
  BorderColor #475569
  BorderThickness 1.2
  FontColor #0F172A
  FontSize 11
  FontStyle bold
  ArrowColor #334155
  ArrowFontColor #1E293B
  ArrowFontSize 10
}

' ============================================================
'  1. KÖK DÜĞÜM (Root Node)
' ============================================================

[*] --> S_EVAL : Transfer Talebi (POST /transfers)\n[Bakiye ve Günlük Limit Uygun]

state "PENDING_EVALUATION\n---\n• 18 Özellik Vektörü Çıkarımı\n• ONNX XGBoost Risk Skoru (0-100)\n• Kural: Tutar > 500k TL & Bakiye > %70" as S_EVAL #FEF3C7

' ============================================================
'  2. AĞAÇ DALLARI (Tree Branches)
' ============================================================

' --- DAL 1: Düşük Risk ---
state "DAL 1: DÜŞÜK RİSK (%0 - 25)" as Branch1 #F0FDF4 {
  state "APPROVE\n(Doğrudan Onay)" as B1_Approve #DCFCE7
  state "COMPLETED\n(Bakiye Aktarıldı)" as B1_Comp #86EFAC
  
  B1_Approve --> B1_Comp : Bakiye Düş
}

' --- DAL 2: Orta & Yüksek Risk ---
state "DAL 2: ORTA / YÜKSEK RİSK (%26 - 80)" as Branch2 #EFF6FF {
  state "PUSH_CHALLENGED\n(Mobil Onay Bekleniyor)" as B2_Push #DBEAFE
  state "COMPLETED\n(Transfer Başarılı)" as B2_Comp #86EFAC
  state "REJECTED\n(İşlem İptal)" as B2_Rej #FECDD3
  
  B2_Push --> B2_Comp : Mobilde "ONAYLA"
  B2_Push --> B2_Rej : "REDDET" / 60s Zaman Aşımı
}

' --- DAL 3: Kritik Risk ---
state "DAL 3: KRİTİK RİSK (%81 - 100 veya Kural)" as Branch3 #FFF7ED {
  state "CRITICAL_PUSH_CHALLENGED\n(1. Aşama: Mobil Bildirim)" as B3_Crit #FED7AA
  state "OTP_CHALLENGED\n(2. Aşama: E-posta Kodu)" as B3_Otp #FDBA74
  state "COMPLETED\n(Transfer Başarılı)" as B3_Comp #86EFAC
  state "REJECTED\n(İşlem İptal)" as B3_Rej #FECDD3
  
  B3_Crit --> B3_Otp : 1. Aşama Onaylandı
  B3_Crit --> B3_Rej : 1. Aşamada Reddedildi
  B3_Otp --> B3_Comp : 2. Aşama Doğru OTP
  B3_Otp --> B3_Rej : Hatalı Kod / Süre Bitti
}


' ============================================================
'  KÖKTEN DALLARA BAĞLANTILAR (Tree Distribution)
' ============================================================

S_EVAL --> B1_Approve : [Risk Skoru 0 - 25]
S_EVAL --> B2_Push : [Risk Skoru 26 - 80]
S_EVAL --> B3_Crit : [Risk Skoru 81 - 100\nveya Kritik Kural]

@enduml
